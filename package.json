{
  "name": "invoice-management",
  "version": "1.0.0",
  "homepage": "https://github.com/frazghuman/invoice-management",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production --base-href ./",
    "build:dev": "ng build --configuration development --base-href ./",
    "build:electron": "ng build --configuration production --base-href ./ && electron-builder",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "serve:ssr:invoice-management": "node dist/invoice-management/server/server.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "main": "electron-main.js",
  "files": [
    "dist/",
    "electron-main.js"
  ],
  "build": {
    "asar": false,
    "appId": "com.example.invoice-management",
    "files": [
      "dist/",
      "electron-main.js"
    ],
    "directories": {
      "output": "dist/electron"
    },
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    }
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/platform-server": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/ssr": "^17.0.3",
    "@auth0/angular-jwt": "^5.2.0",
    "@ngx-translate/core": "^15.0.0",
    "@ngx-translate/http-loader": "^8.0.0",
    "@vercel/speed-insights": "^1.0.12",
    "echarts": "^5.5.1",
    "express": "^4.18.2",
    "html2canvas": "^1.4.1",
    "jsdom": "^24.0.0",
    "jspdf": "^2.5.1",
    "jspdf-autotable": "^3.8.2",
    "lodash": "^4.17.21",
    "moment": "^2.30.1",
    "moment-timezone": "^0.5.45",
    "ngx-echarts": "^18.0.0",
    "ngx-infinite-scroll": "^17.0.0",
    "primeicons": "^6.0.1",
    "primeng": "^17.9.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.14.2"
  },
  "devDependencies": {
    "@angular-builders/custom-webpack": "^17.0.1",
    "@angular-devkit/build-angular": "^17.0.3",
    "@angular/cli": "^17.0.3",
    "@angular/compiler-cli": "^17.0.0",
    "@types/express": "^4.17.17",
    "@types/jasmine": "~5.1.0",
    "@types/lodash": "^4.14.202",
    "@types/node": "^18.18.0",
    "autoprefixer": "^10.4.18",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "gh-pages": "^6.1.1",
    "jasmine-core": "~5.1.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "~5.2.2"
  }
}
